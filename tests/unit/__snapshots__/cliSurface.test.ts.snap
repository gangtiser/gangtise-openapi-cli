exports[`CLI surface > help > help: gangtise indicator cross-section 1`] = `
"Usage: gangtise indicator cross-section [options]

Options:
  --indicator <code>        Indicator code, e.g. qte_close (REQUIRED, repeat for
                            multiple) (default: [])
  --security <code>         Security code, e.g. 600519.SH, or a sector ID from
                            'gangtise reference sector-search' (REQUIRED,
                            repeat; union, deduped) (default: [])
  --date <date>             Data date (yyyy-MM-dd); sent as each indicator's
                            tradeDate. Report-period indicators (is_*, financial
                            statements) REJECT tradeDate and require
                            --indicator-param 'code:reportDate=yyyy-MM-dd'
                            instead — check parameterList in 'indicator search'
  --currency <code>         Currency: DFT/CNY/HKD/USD/EUR/GBP/JPY/TWD/MOP/AUD
                            (default DFT)
  --scale <code>            Scale: 0=个 3=千 4=万 6=百万 8=亿 9=十亿 (default 0)
  --indicator-param <spec>  Per-indicator param 'code:key=value', e.g.
                            qte_close:adjustType=2 for 前复权 (repeat); read exact
                            keys from 'indicator search'. Bare 'code:' (nothing
                            after the colon) declares the indicator takes NO
                            date — required by any indicator whose parameterList
                            has no date key at all, which otherwise rejects the
                            tradeDate --date injects: the pty_* / scr_*
                            static-attribute families (pty_op_scope,
                            scr_exchg_mkt, scr_isin …), plus div_cash_paid_ratio
                            / div_cash_yr (add 'code:fiscalYear=YYYY' too) and
                            pty_shr_reg. It composes with real params, so
                            'code:' + 'code:scale=8' keeps the scale (default:
                            [])
  --key-by <mode>           Column key: name=display name (default) |
                            code=indicatorCode, unique & order-stable for batch
                            code→value mapping (choices: "name", "code",
                            default: "name")
  --format <format>         Output format (default: "table")
  --output <path>
  -h, --help                display help for command
"
`;

exports[`CLI surface > help > help: gangtise indicator screener 1`] = `
"Usage: gangtise indicator screener [options]

Screen securities by an expression over indicator values (条件选股)

Options:
  --indicator <spec>        Bind a variable to an indicator, 'F1:code', e.g.
                            F1:qte_mkt_cptl (REQUIRED, repeat) (default: [])
  --security <code>         Security code, e.g. 600519.SH, or a sector ID from
                            'gangtise reference sector-search' (REQUIRED,
                            repeat; union, deduped) (default: [])
  --expression <expr>       Filter over the bound variables, e.g. 'F1 >= 800 &&
                            (F2 >= 20 && F2 <= 30)'; also supports
                            contains/notcontains on string indicators
  --date <date>             Data date (yyyy-MM-dd); sent as every indicator's
                            tradeDate unless it already has one. Report-period
                            indicators (is_*) reject tradeDate: give them
                            --indicator-param 'F1:reportDate=yyyy-MM-dd'
  --indicator-param <spec>  Per-variable param 'F1:key=value', e.g. F1:scale=8
                            (repeat); read exact keys from 'indicator search'.
                            Bare 'F1:' (nothing after the colon) declares that
                            the indicator takes NO date — required by any
                            indicator whose parameterList has no date key at
                            all, which otherwise rejects the tradeDate --date
                            injects: the pty_* / scr_* static-attribute families
                            (pty_op_scope, scr_exchg_sctr, scr_isin …), plus
                            div_cash_paid_ratio / div_cash_yr (add
                            'F1:fiscalYear=YYYY' too) and pty_shr_reg. It
                            composes with real params, so 'F1:' + 'F1:scale=8'
                            keeps the scale (default: [])
  --key-by <mode>           Column key: name=display name (default) |
                            code=indicatorCode (choices: "name", "code",
                            default: "name")
  --format <format>         Output format (default: "table")
  --output <path>
  -h, --help                display help for command
"
`;

exports[`CLI surface > help > help: gangtise indicator search 1`] = `
"Usage: gangtise indicator search [options]

Options:
  --keyword <text>   Search keyword, e.g. '收盘价' '成交量' '营业收入' (not free-form
                     questions)
  --limit <number>   Max results (default: 50, max: 100) (default: "50")
  --format <format>  Output format (default: "table")
  --output <path>
  -h, --help         display help for command
"
`;

exports[`CLI surface > help > help: gangtise indicator time-series 1`] = `
"Usage: gangtise indicator time-series [options]

Options:
  --indicator <code>        Indicator code, e.g. qte_close (REQUIRED, repeat for
                            multiple) (default: [])
  --security <code>         Security code, e.g. 600519.SH, or a sector ID from
                            'gangtise reference sector-search' (REQUIRED,
                            repeat; union, deduped) (default: [])
  --start-date <date>       Start date (yyyy-MM-dd)
  --end-date <date>         End date (yyyy-MM-dd)
  --calendar-type <type>    Calendar: ND=natural TD=trading WD=weekday. Omit it
                            and the CLI picks: a free 'indicator search' reads
                            each parameterList and sends TD only when EVERY
                            indicator is trading-day typed, otherwise it leaves
                            the server on ND (report-period indicators land on
                            dates a trading calendar lacks, and TD would answer
                            them with an all-null grid). An explicit value is
                            sent as given, with no lookup
  --currency <code>         Currency: DFT/CNY/HKD/USD/EUR/GBP/JPY/TWD/MOP/AUD
                            (default DFT)
  --scale <code>            Scale: 0=个 3=千 4=万 6=百万 8=亿 9=十亿 (default 0)
  --indicator-param <spec>  Per-indicator param 'code:key=value', e.g.
                            qte_close:adjustType=2 for 前复权 (repeat); read exact
                            keys from 'indicator search' (default: [])
  --key-by <mode>           Column key: name=display name (default) |
                            code=indicatorCode/securityCode, unique &
                            order-stable for batch mapping (choices: "name",
                            "code", default: "name")
  --format <format>         Output format (default: "table")
  --output <path>
  -h, --help                display help for command
"
`;

