exports[`CLI surface > help > help: gangtise tool 1`] = `
"Usage: gangtise tool [options] [command]

Research tool APIs: PDF parsing

Options:
  -h, --help                  display help for command

Commands:
  file-parse [options]        Parse a PDF into Markdown + images (async; 0.8
                              credits/page, billed at submit)
  file-parse-check [options]  Download a finished file-parse result ZIP by
                              taskId (free)
  web-search [options]        Search the public web for research: deduped,
                              source-tiered (T0-T3) results with optional page
                              content (1 credit/call)
  help [command]              display help for command
"
`;

exports[`CLI surface > help > help: gangtise tool file-parse 1`] = `
"Usage: gangtise tool file-parse [options]

Parse a PDF into Markdown + images (async; 0.8 credits/page, billed at submit)

Options:
  --file <path>    PDF to upload (max 100MB / 500 pages)
  --wait           Wait for the parse to finish and save the result ZIP
                   (blocking, up to ~5 min)
  --output <path>  Where to save the result ZIP (used with --wait)
  -h, --help       display help for command
"
`;

exports[`CLI surface > help > help: gangtise tool file-parse-check 1`] = `
"Usage: gangtise tool file-parse-check [options]

Download a finished file-parse result ZIP by taskId (free)

Options:
  --task-id <id>   taskId from 'tool file-parse'
  --output <path>  Where to save the result ZIP
  -h, --help       display help for command
"
`;

exports[`CLI surface > help > help: gangtise tool web-search 1`] = `
"Usage: gangtise tool web-search [options]

Search the public web for research: deduped, source-tiered (T0-T3) results with
optional page content (1 credit/call)

Options:
  --query <text>                Search query, 1-200 chars. Sent verbatim — no
                                intent rewriting server-side, so spell out what
                                you want
  --size <number>               Results to return, 1-20 (1-5 with
                                --include-content) (default: "10")
  --freshness <window>          Time window over publishTime; results with no
                                resolvable publish date are dropped by
                                day/week/month (choices: "day", "week", "month",
                                "none")
  --min-tier <tier>             Lowest source tier to keep; T3 = no filtering
                                (choices: "T0", "T1", "T2", "T3")
  --site <domain>               Restrict to a registered domain or subdomain,
                                e.g. csrc.gov.cn (repeatable, max 10, OR-ed)
                                (default: [])
  --include-content             Return page body as Markdown; caps --size at 5
  --max-content-chars <number>  Max chars per body, 1000-20000 (only with
                                --include-content)
  --format <format>             Output format (default: "table")
  --output <path>
  -h, --help                    display help for command
"
`;

exports[`CLI surface > help > help: gangtise vault 1`] = `
"Usage: gangtise vault [options] [command]

Vault APIs

Options:
  -h, --help                         display help for command

Commands:
  drive-list [options]
  drive-download [options]
  drive-folder-list [options]        List the direct subfolders and files of a
                                     drive folder (free)
  drive-upload [options]             Upload a file to the AI drive (free; max
                                     100MB per file; trial accounts max
                                     500MB/day)
  drive-create-folder [options]      Create a drive folder (free). Same-name
                                     folders are allowed, so re-running creates
                                     a second one
  drive-rename [options]             Rename a drive file or folder (free)
  drive-move-file [options]          Move drive files into a folder of the SAME
                                     space (free)
  drive-move-folder [options]        Move a drive folder under another folder of
                                     the SAME space (free)
  drive-copy [options]               Copy files to the OTHER space: my drive <->
                                     tenant drive (free; same-space copies are
                                     rejected)
  drive-delete-file [options]        Delete drive files — irreversible (free)
  drive-delete-folder [options]      Delete a drive folder AND every subfolder
                                     and file inside it — irreversible (free)
  record-list [options]
  record-download [options]
  my-conference-list [options]
  my-conference-download [options]
  wechat-message-list [options]
  wechat-chatroom-list [options]
  stock-pool-list [options]
  stock-pool-stocks [options]
  stock-pool-create [options]
  stock-pool-rename [options]
  stock-pool-add-stock [options]
  stock-pool-remove-stock [options]
  stock-pool-delete [options]
  help [command]                     display help for command
"
`;

exports[`CLI surface > help > help: gangtise vault drive-copy 1`] = `
"Usage: gangtise vault drive-copy [options]

Copy files to the OTHER space: my drive <-> tenant drive (free; same-space
copies are rejected)

Options:
  --file-id <id>           Source file ID (repeat or comma-separate)
  --target-folder-id <id>  Destination folder ID in the other space, or 'root'
                           for that space's root
  --format <format>        Output format (default: "json")
  --output <path>
  -h, --help               display help for command
"
`;

exports[`CLI surface > help > help: gangtise vault drive-create-folder 1`] = `
"Usage: gangtise vault drive-create-folder [options]

Create a drive folder (free). Same-name folders are allowed, so re-running
creates a second one

Options:
  --name <name>      Folder name, max 200 characters (230004 past that)
  --space-type <n>   Space: 1=my drive 2=tenant drive (shared with your whole
                     tenant) (choices: "1", "2", default: "1")
  --parent-id <id>   Parent folder ID in that space; omit (or 'root') for the
                     root
  --format <format>  Output format (default: "json")
  --output <path>
  -h, --help         display help for command
"
`;

exports[`CLI surface > help > help: gangtise vault drive-delete-file 1`] = `
"Usage: gangtise vault drive-delete-file [options]

Delete drive files — irreversible (free)

Options:
  --file-id <id>     File ID to delete (repeat or comma-separate)
  --yes              Required: confirm the deletion
  --format <format>  Output format (default: "json")
  --output <path>
  -h, --help         display help for command
"
`;

exports[`CLI surface > help > help: gangtise vault drive-delete-folder 1`] = `
