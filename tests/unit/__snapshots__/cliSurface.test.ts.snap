"
`;

exports[`CLI surface > help > help: gangtise quote day-kline 1`] = `
"Usage: gangtise quote day-kline [options]

Options:
  --security <code>    Security code — A-share .SH/.SZ/.BJ, ETF .SH/.SZ (e.g.
                       512800.SH), HK .HK, US .O/.N/.A, exchange index
                       .SH/.SZ/.BJ, concept index .GT, industry index .CI/.SWI,
                       global index (e.g. SPX.SPI / N225.NKI / HSI.HI); or one
                       market keyword: aShares / hkStocks / usStocks
                       (auto-sharded by date, must be passed alone; keywords
                       cover stocks only — ETFs and indices must be listed by
                       code) (default: [])
  --start-date <date>  Start date (default: 1 year before end-date)
  --end-date <date>    End date (default: latest)
  --limit <number>     Max rows per request (default: 6000, max: 10000). With
                       several securities it also sizes the groups they are
                       fetched in, so a small value fetches one security per
                       request
  --field <field>      Field (default: [])
  --format <format>    Output format (default: "table")
  --output <path>
  -h, --help           display help for command
"
`;

