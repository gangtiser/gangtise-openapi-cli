exports[`CLI surface > help > help: gangtise insight announcement list 1`] = `
"Usage: gangtise insight announcement list [options]

Options:
  --search-type <number>   Search type: 1=title 2=fulltext (choices: "1", "2",
                           default: "1")
  --rank-type <number>     Rank type: 1=composite 2=time desc (choices: "1",
                           "2", default: "1")
  --security <code>        Security code (default: [])
  --category <id>          Category ID (default: [])
  --format <format>        Output format (default: "table")
  --output <path>          Output path
  --from <number>          Starting offset (default: "0")
  --size <number>          Total rows to return; omit to fetch all
  --start-time <datetime>  Start time
  --end-time <datetime>    End time
  --keyword <keyword>      Keyword
  --yes                    Fetch every row even when a fetch without --size is
                           estimated above the credit guard (the list is billed
                           per row)
  -h, --help               display help for command
"
