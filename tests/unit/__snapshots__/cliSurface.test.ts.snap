exports[`CLI surface > help > help: gangtise bond 1`] = `
"Usage: gangtise bond [options] [command]

Bond APIs: profiles, issuers, quotes, valuations, cash flows, ratings,
announcements

Options:
  -h, --help                      display help for command

Commands:
  basic-info [options]            Bond static profiles: issuance, term, coupon,
                                  rating, guarantee, special terms
  rating-overview [options]       Bond, issuer and guarantor ratings side by
                                  side
  cash-flow [options]             Interest payment and redemption schedule per
                                  bond
  issuance-detail [options]       Issuance and re-issuance records: bidding,
                                  pricing, cover ratios
  rating-change [options]         Bond rating change history: current vs
                                  previous rating, direction, outlook, agency
                                  (max 10 bonds per call)
  exercise-notice [options]       Put/call exercise schedule and results for
                                  option-embedded bonds
  daily-quote [options]           Daily close quotes (exchange + CFETS):
                                  dirty/clean price, YTM, duration, convexity
  valuation [options]             Shanghai Clearing House valuations: price,
                                  yield, duration, convexity, PVBP
  issuer-info [options]           Issuer profiles: nature, SW industry,
                                  registration, rating, outstanding bonds
  issuer-rating-change [options]  Issuer rating change history (at most 10
                                  issuers matched per call)
  issuance-plan [options]         Rate-bond issuance calendar over a date range
  announcement [options]          Bond announcements, paged. Filter by bond
                                  codes OR by announcement date range, never
                                  both
  help [command]                  display help for command
"
`;

exports[`CLI surface > help > help: gangtise bond announcement 1`] = `
"Usage: gangtise bond announcement [options]

Bond announcements, paged. Filter by bond codes OR by announcement date range,
never both

Options:
  --security <code>     Bond code, e.g. 019742.SH / 123456.SZ / 220205.IB
                        (repeatable). Short names and pinyin are rejected —
                        resolve them with 'reference securities-search' first
                        (default: [])
  --field <field>       Field to return (repeatable); omit for all. An
                        unsupported name rejects the whole call with 100003
                        (default: [])
  --format <format>     Output format (default: "table")
  --output <path>
  --start-date <date>   Announcement date range start (yyyy-MM-dd); mutually
                        exclusive with --security
  --end-date <date>     Announcement date range end (yyyy-MM-dd); mutually
                        exclusive with --security
  --page-no <number>    Page number, from 1. No total is returned: increment
                        until a page comes back empty (default: "1")
  --page-size <number>  Rows per page, 1-200 (default: "50")
  -h, --help            display help for command
"
`;

