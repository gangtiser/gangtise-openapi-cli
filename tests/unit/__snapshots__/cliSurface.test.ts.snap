exports[`CLI surface > invocations > bare: raw list 1`] = `
{
  "argv": [
    "raw",
    "list",
  ],
  "exit": 0,
  "requests": [],
  "stderr": "",
  "stdout": "key                                        method  path                                                                            description                                                                                  
-----------------------------------------  ------  ------------------------------------------------------------------------------  ---------------------------------------------------------------------------------------------
auth.login                                 POST    /application/auth/oauth/open/loginV2                                            Get access token                                                                             
lookup.broker-orgs.list                    GET     /guide/broker-orgs-local                                                        List broker orgs from local docs                                                             
lookup.meeting-orgs.list                   GET     /guide/meeting-orgs-local                                                       List meeting orgs from local docs                                                            
insight.opinion.list                       POST    /application/open-insight/chief-opinion/v2/getList                              List domestic institution chief opinions (brief only; body via detail)                       
insight.opinion.list-with-content          POST    /application/open-insight/chief-opinion/getList                                 List domestic institution chief opinions with the full body (v1 list)                        
insight.opinion.detail                     POST    /application/open-insight/chief-opinion/getDetail                               Get domestic chief opinion bodies by ID (max 20 IDs per call)                                
insight.summary.list                       POST    /application/open-insight/summary/v2/getList                                    List summaries                                                                               
insight.summary.download                   GET     /application/open-insight/summary/v2/download/file                              Download summary file                                                                        
insight.pamirs-summary.list                POST    /application/open-insight/pamirs-summary/getList                                List Pamirs expert summaries (requires the expert-summary database)                          
insight.pamirs-summary.download            GET     /application/open-insight/pamirs-summary/download/file                          Download a Pamirs expert summary file                                                        
insight.roadshow.list                      POST    /application/open-insight/schedule/roadshow/getList                             List roadshows                                                                               
insight.site-visit.list                    POST    /application/open-insight/schedule/site-visit/getList                           List site visits                                                                             
insight.strategy.list                      POST    /application/open-insight/schedule/strategy-meeting/getList                     List strategy meetings                                                                       
insight.forum.list                         POST    /application/open-insight/schedule/forum/getList                                List forums                                                                                  
insight.performance-calendar.list          POST    /application/open-insight/schedule/performance-calendar/getList                 List earnings calendar events (forecast / express / announcement)                            
insight.performance-calendar.download      GET     /application/open-insight/schedule/performance-calendar/download/file           Download an earnings report file (A-share 10 credits, HK/US 20)                              
insight.research.list                      POST    /application/open-insight/broker-report/getList                                 List broker research reports                                                                 
insight.research.download                  GET     /application/open-insight/broker-report/download/file                           Download broker research report                                                              
insight.foreign-report.list                POST    /application/open-insight/foreign-report/getList                                List foreign reports                                                                         
insight.foreign-report.download            GET     /application/open-insight/foreign-report/download/file                          Download foreign report                                                                      
insight.announcement.list                  POST    /application/open-insight/announcement/getList                                  List A-share announcements                                                                   
insight.announcement.download              GET     /application/open-insight/announcement/download/file                            Download A-share announcement file                                                           
insight.announcement-hk.list               POST    /application/open-insight/announcement-hk/getList                               List HK announcements                                                                        
insight.announcement-hk.download           GET     /application/open-insight/announcement-hk/download/file                         Download HK announcement file                                                                
insight.announcement-us.list               POST    /application/open-insight/announcement-us/getList                               List US announcements                                                                        
insight.announcement-us.download           GET     /application/open-insight/announcement-us/download/file                         Download US announcement file                                                                
insight.foreign-opinion.list               POST    /application/open-insight/foreign-opinion/v2/getList                            List foreign institution opinions (brief only; body via detail)                              
insight.foreign-opinion.list-with-content  POST    /application/open-insight/foreign-opinion/getList                               List foreign institution opinions with the full body (v1 list)                               
insight.foreign-opinion.detail             POST    /application/open-insight/foreign-opinion/getDetail                             Get foreign opinion bodies by ID (max 20 IDs per call)                                       
insight.independent-opinion.list           POST    /application/open-insight/independent-opinion/getList                           List foreign independent analyst opinions                                                    
insight.independent-opinion.download       GET     /application/open-insight/independent-opinion/download/file                     Download foreign independent opinion file                                                    
insight.official-account.list              POST    /application/open-insight/officialAccount/getList                               List WeChat official account articles                                                        
insight.official-account.download          GET     /application/open-insight/officialAccount/download/file                         Download WeChat official account article (txt/HTML)                                          
insight.qa.list                            POST    /application/open-insight/Q&A-data/getList                                      List investor Q&A (conference/interactive/survey) for a security                             
insight.report-image.list                  POST    /application/open-insight/report-image/getList                                  Search research report images by keyword (returns chunkId + metadata)                        
insight.highlight.list                     POST    /application/open-insight/summary/highlight/getList                             List meeting highlights (核心要点信息流; content is an HTML fragment)                        
insight.report-image.download              GET     /application/open-insight/report-image/download/file                            Download a research report image by chunkId                                                  
reference.securities-search                POST    /application/open-reference/securities/search                                   Search GTS codes (securities)                                                                
reference.chiefs-search                    POST    /application/open-reference/chiefs/search                                       Search chief analyst IDs by name / institution / team                                        
reference.institution-search               POST    /application/open-reference/institutions/search                                 Search institution IDs by keyword (domestic broker / foreign / lead / opinion institution)   
reference.official-account-search          POST    /application/open-reference/officialAccount/search                              Search official account (WeChat public account) IDs by name / institution / category         
reference.constant-category                GET     /application/open-reference/constants/category                                  List constant categories and their API usage scopes                                          
reference.constant-list                    POST    /application/open-reference/constants/getList                                   List all constant values of a category                                                       
