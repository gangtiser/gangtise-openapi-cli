exports[`CLI surface > help > help: gangtise 1`] = `
"Usage: gangtise [options] [command]

Gangtise OpenAPI CLI

Options:
  -V, --version   output the version number
  --verbose       Print per-request timings to stderr (also: GANGTISE_VERBOSE=1)
  -h, --help      display help for command

Commands:
  auth            Authentication commands
  lookup          Local lookup tables (IDs not covered by 'reference
                  constant-list')
  insight         Insight APIs
  quote           Quote APIs
  fundamental     Fundamental APIs
  bond            Bond APIs: profiles, issuers, quotes, valuations, cash flows,
                  ratings, announcements
  reference       Reference data APIs
  vault           Vault APIs
  ai              AI APIs
  alternative     Alternative data APIs
  indicator       Data indicator (EDE) APIs: search codes, cross-section,
                  time-series, screener
  tool            Research tool APIs: PDF parsing
  raw             Raw API calls
  help [command]  display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai 1`] = `
"Usage: gangtise ai [options] [command]

AI APIs

Options:
  -h, --help                                  display help for command

Commands:
  knowledge-batch [options]
  knowledge-resource-download [options]
  security-clue [options]
  one-pager [options]
  investment-logic [options]
  peer-comparison [options]
  earnings-review [options]
  earnings-review-check [options]
  theme-tracking [options]
  research-outline [options]
  hot-topic [options]
  management-discuss-announcement [options]
  management-discuss-earnings-call [options]
  viewpoint-debate [options]
  viewpoint-debate-check [options]
  stock-summary [options]                     Stock highlights: refined research summary per security (A-share / HK)
  help [command]                              display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai earnings-review 1`] = `
"Usage: gangtise ai earnings-review [options]

Options:
  --security-code <code>
  --period <period>       Report period (e.g. 2025q3, 2025interim, 2025annual)
  --wait                  Wait for content generation (blocking, up to ~5 min)
  --format <format>       Output format (default: "json")
  --output <path>
  -h, --help              display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai earnings-review-check 1`] = `
"Usage: gangtise ai earnings-review-check [options]

Options:
  --data-id <id>     dataId from earnings-review
  --format <format>  Output format (default: "json")
  --output <path>
  -h, --help         display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai hot-topic 1`] = `
"Usage: gangtise ai hot-topic [options]

Options:
  --from <number>               Starting offset (default: "0")
  --size <number>               Total rows to return; omit to fetch all
  --start-date <date>           Start date (yyyy-MM-dd)
  --end-date <date>             End date (yyyy-MM-dd)
  --category <name>             Report type:
                                morningBriefing/noonBriefing/afternoonFlash/eveningBriefing
                                (default: [])
  --with-related-securities     Include related securities info
  --no-with-related-securities  Exclude related securities info
  --with-close-reading          Include close reading content
  --no-with-close-reading       Exclude close reading content
  --format <format>             Output format (default: "json")
  --output <path>
  --yes                         Fetch every row even when a fetch without --size
                                is estimated above the credit guard (the list is
                                billed per row)
  -h, --help                    display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai investment-logic 1`] = `
"Usage: gangtise ai investment-logic [options]

Options:
  --security-code <code>
  --format <format>       Output format (default: "json")
  --output <path>
  -h, --help              display help for command
"
`;

exports[`CLI surface > help > help: gangtise ai knowledge-batch 1`] = `
"Usage: gangtise ai knowledge-batch [options]

Options:
  --query <text>            Query text; repeat for up to 5. Each --query is
                            taken whole — commas inside it are part of the
                            question, not separators (default: [])
  --top <number>            Max results (default: 10, max: 20) (default: "10")
  --resource-type <number>  Resource type (default: [])
  --knowledge-name <name>   Knowledge name (default: [])
  --start-time <datetime>   13/10-digit epoch or YYYY-MM-DD[ HH:mm[:ss]] (space
                            or T)
  --end-time <datetime>     13/10-digit epoch or YYYY-MM-DD[ HH:mm[:ss]] (space
                            or T)
  --format <format>         Output format (default: "json")
  --output <path>
  -h, --help                display help for command
"
`;

