                     'gangtise reference concept-search'
  --full             Also return the key-stock flag (isKey) and inclusion reason
                     via the v1 endpoint — 500 credits/call instead of 50
  --format <format>  Output format (default: "json")
  --output <path>
  -h, --help         display help for command
"
`;

