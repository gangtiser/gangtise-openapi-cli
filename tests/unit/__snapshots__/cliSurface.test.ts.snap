exports[`CLI surface > invocations > full: reference chiefs-search 1`] = `
{
  "argv": [
    "reference",
    "chiefs-search",
    "--keyword",
    "kw",
    "--top",
    "3",
    "--format",
    "json",
  ],
  "exit": 0,
  "requests": [
    {
      "body": {
        "keyword": "kw",
        "top": 3,
      },
      "method": "POST",
      "path": "/application/open-reference/chiefs/search",
    },
  ],
  "stderr": "",
  "stdout": "{
  "total": 1,
  "list": [
    {
      "id": "1",
      "title": "t",
      "value": 1
    }
  ]
}
",
}
`;

